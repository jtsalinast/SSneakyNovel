{
  "name": "@xianii/design-system",
  "version": "2.2.0",
  "type": "module",
  "description": "Xianii theme tokens — framework-agnostic CSS custom properties, with optional Tailwind and daisyUI adapters",
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./tailwind.css": "./adapters/tailwind.css",
    "./daisyui.css": "./adapters/daisyui.css"
  },
  "files": [
    "tokens.css",
    "theme.css",
    "adapters",
    "docs/preview.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:preview": "node ./scripts/generate-preview.mjs"
  },
  "keywords": [
    "theme",
    "design-tokens",
    "css",
    "tailwindcss",
    "daisyui"
  ],
  "peerDependencies": {
    "tailwindcss": "^4",
    "daisyui": "^5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "daisyui": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nigh/xianii-theme.git",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "access": "public"
  }
}
